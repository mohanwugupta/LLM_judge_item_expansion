{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature_generation_response_v3",
  "title": "Leuven-style free feature-generation response",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_word", "features"],
  "properties": {
    "target_word": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "features": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    }
  }
}
